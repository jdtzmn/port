FROM docker:27.5.1-cli AS certificates
FROM oven/bun:1.3.3 AS bun-runtime
FROM postgres:17.4-bookworm
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=certificates /usr/local/bin/docker /usr/local/bin/docker
COPY --from=certificates /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/* \
    && apt-get -o APT::Update::Error-Mode=any update && apt-get install -y --no-install-recommends openssh-server git dnsmasq \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
    && useradd --create-home --shell /bin/bash fixture && passwd -d fixture \
    && mkdir -p /run/sshd
COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
COPY port-cli.sh /usr/local/bin/port
RUN chmod 755 /usr/local/bin/port && mkdir -p /opt/port
COPY sshd_config /etc/ssh/sshd_config
COPY remote.sh identity.ts /fixture/
ENTRYPOINT ["bash", "/fixture/remote.sh"]
